# Optional external credentials used by the SDK default chains.
# Provider names, endpoints, regions, buckets, and contexts belong in
# ~/Library/Application Support/Abyss/connections.toml, not this file.

# AWS / S3-compatible
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=your_optional_temporary_session_token

# Azure client-secret-environment credential
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret

# Google Application Default Credentials
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Kubernetes; multiple files use the platform path-list separator.
KUBECONFIG=/path/to/config
